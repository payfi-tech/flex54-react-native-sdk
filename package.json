{
  "name": "@flexsmb54/react-native-widget",
  "version": "0.1.0",
  "description": "Flex54 chat widget for React Native (WebView based, no native code)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src",
    "assets",
    "README.md",
    "!src/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "render-icon": "node scripts/render-icon.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-safe-area-context": ">=4",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
